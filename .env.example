# Which model drives the verification agent.
# Tool calling is the whole job here, so pick one that does it reliably.
#   google | openrouter | groq | bedrock | openai
PROTO_MODEL_PROVIDER=google

# Optional: override the provider's default model.
# PROTO_MODEL_ID=

# Google AI Studio, free tier, no card
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter, use a tool capable model
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq, free tier
#   https://console.groq.com/keys
GROQ_API_KEY=

# Amazon Bedrock, needs AWS credentials and model access
AWS_REGION=us-east-1

# Free tiers cap the tokens a single call may reserve. Raise only on a paid plan.
PROTO_MAX_TOKENS=2048

# Where the server listens. Hosts usually set this for you.
PORT=8787

# Where run journals are written. Only worth setting to keep a test run from
# colliding with a server that is already up.
# PROTO_STATE_DIR=.proto-state
