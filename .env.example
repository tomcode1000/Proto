# Provider: google | openrouter | groq | bedrock | openai
# Tool calling is core to Proto — google is the most reliable free option.
PROTO_MODEL_PROVIDER=google

# Optional: override the provider's default model
# PROTO_MODEL_ID=

# Google AI Studio free tier — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (use a ":free" model id)
OPENROUTER_API_KEY=

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=

# Bedrock (optional swap; needs AWS creds + model access)
AWS_REGION=us-east-1

# Free tiers cap affordable tokens; raise only on a paid account
PROTO_MAX_TOKENS=2048
